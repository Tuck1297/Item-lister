# ---- App ----
PORT=3000
# Keep this on 127.0.0.1: the server can drive your logged-in Facebook/Poshmark browsers.
HOST=127.0.0.1

# review = fill the Facebook/Poshmark forms and wait for you to click Publish (recommended)
# auto   = click Publish too (falls back to review if any field couldn't be filled)
POST_MODE=review
REVIEW_TIMEOUT_MINUTES=15

# chrome = your installed Google Chrome (looks least like a bot); chromium = Playwright's bundled build
BROWSER_CHANNEL=chrome
# Must stay false to log in from the UI
HEADLESS=false

# ---- eBay app keys (developer.ebay.com → Application Keys) ----
# Everything else (signing in, policies, ship-from location) is done in the UI under Connections.
# Start with sandbox; switch to production once a test listing works.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay Redirect URL name) from "User Tokens" on the developer portal
EBAY_RU_NAME=

EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_LOCATION_COUNTRY=US

# Optional: policy IDs here are used only until you pick policies in the UI.
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_MERCHANT_LOCATION_KEY=home
