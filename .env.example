# ---- App ----
PORT=3000
# Keep this on 127.0.0.1: the server can drive your logged-in Facebook/Poshmark browser profiles.
HOST=127.0.0.1

# review = fill the Facebook/Poshmark forms and wait for you to click Publish (recommended)
# auto   = click Publish too (falls back to review if any field couldn't be filled)
POST_MODE=review
REVIEW_TIMEOUT_MINUTES=15

# chrome = your installed Google Chrome (looks least like a bot); chromium = Playwright's bundled build
BROWSER_CHANNEL=chrome
HEADLESS=false

# ---- eBay (developer.ebay.com → Application Keys) ----
# Start with sandbox, switch to production once a test listing works.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay Redirect URL name) from "User Tokens" on the developer portal
EBAY_RU_NAME=

# Printed by `npm run ebay:setup`
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# Where items ship from; ebay:setup creates this location from the postal code
EBAY_MERCHANT_LOCATION_KEY=home
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_COUNTRY=US

EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
