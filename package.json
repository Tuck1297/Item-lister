{
  "name": "item-lister",
  "version": "0.2.0",
  "private": true,
  "description": "Store items in SQLite and crosslist them to eBay (Sell API), Facebook Marketplace and Poshmark (browser automation), from a React + Mantine UI.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server.ts",
    "serve": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/dropzone": "^8.3.0",
    "@mantine/form": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/modals": "^8.3.0",
    "@mantine/notifications": "^8.3.0",
    "@tabler/icons-react": "^3.34.0",
    "playwright": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  }
}
